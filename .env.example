# Exemplo de Contexto Yby
# Este arquivo serve como modelo para criar contextos manuais (ex: .env.prod)
# O comando 'yby init' gera esses arquivos automaticamente.

# [OBRIGATÓRIO] Token do GitHub (PAT) com permissão de 'repo'
# Usado para criar secrets de bootstrap e acesso ao repositório
GITHUB_TOKEN=ghp_exampleToken123456

# [OBRIGATÓRIO] Domínio base do cluster
# Ex: meudominio.com (sem https://)
CLUSTER_DOMAIN=cluster.local

# [OBRIGATÓRIO] URL do Repositório GitOps do Cluster
GIT_REPO=https://github.com/my-org/my-infra